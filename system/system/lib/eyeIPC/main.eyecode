// Load custom File-based SharedMemory implementation (no PEAR dependency)
require_once EYE_ROOT . '/' . SYSTEM_DIR . '/' . LIB_DIR . '/eyeIPC/modules/File' . EYE_CODE_EXTENSION;

/**
 * Factory function to create SharedMemory driver instances
 * Replaces System_SharedMemory::factory() from PEAR
 *
 * @param string $type Driver type (currently only 'File' supported)
 * @param array $options Configuration options
 * @return System_SharedMemory_File Driver instance
 */
function eyeIPC_factory($type = 'File', $options = array()) {
	// 3src OS only uses File driver for session storage
	return new System_SharedMemory_File($options);
}

function lib_eyeIPC_setVar($params){
	if($params == null || count($params) < 2){
		errorCodes('setErrorCode',array(INCORRECT_PARAMS));
		return false;
	}

	$name = $params[0];
	$content = $params[1];
	if(isset($params[2])){
		$myClass = eyeIPC_factory($params[2]);
	}else{
		$myClass = eyeIPC_factory();
	}
	$myClass->set($name,$content);
	return true;
}

function lib_eyeIPC_getVar($params){
	if($params == null || count($params) < 1){
		errorCodes('setErrorCode',array(INCORRECT_PARAMS));
		return false;
	}
	$name = $params[0];
	if(isset($params[1])){
		$myClass = eyeIPC_factory($params[1]);
	}else{
		$myClass = eyeIPC_factory();
	}
	return $myClass->get($name);
}

function lib_eyeIPC_rmVar($params){
	if($params == null || count($params) < 1){
		errorCodes('setErrorCode',array(INCORRECT_PARAMS));
		return false;
	}
	$name = $params[0];
	if(isset($params[1])){
		$myClass = eyeIPC_factory($params[1]);
	}else{
		$myClass = eyeIPC_factory();
	}
	$myClass->rm($name);
	return true;
}

function lib_eyeIPC_isSet($params){
	if($params == null || count($params) < 1){
		errorCodes('setErrorCode',array(INCORRECT_PARAMS));
		return false;
	}
	$name = $params[0];
	if(isset($params[1])){
		$myClass = eyeIPC_factory($params[1]);
	}else{
		$myClass = eyeIPC_factory();
	}
	return $myClass->isVar($name);
}